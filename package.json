{
  "name": "baal",
  "version": "0.5.0",
  "description": "Behavioral Anticipatory Autonomy Layer — agentic cognitive protection daemon",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "bin": {
    "baalctl": "bin/baalctl.js"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "demo": "node demo/run-demo.js",
    "test": "node --test \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\"",
    "test:live": "node --test \"tests/live/**/*.test.js\"",
    "check": "find src bin demo index.js -name '*.js' -exec node --check {} +"
  },
  "dependencies": {
    "amqplib": "^0.10.3",
    "pg": "^8.11.3",
    "redis": "^4.6.13"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
