# Infrastructure
REDIS_URL=redis://localhost:6379
PGHOST=localhost
PGPORT=5432
PGDATABASE=baal
PGUSER=baal
PGPASSWORD=
RABBITMQ_URL=amqp://localhost

# Ingestion security — REQUIRED in production. JSON map of producer keys;
# each key may be scoped to the event sources it can emit.
# BAAL_INGEST_KEYS={"wearable-fleet":{"secret":"change-me-32-chars-minimum","sources":["biometric","eeg"]}}
BAAL_INGEST_KEYS=

# Admin API (ack escalations, abort interventions, erase subjects).
# Mutating routes are DISABLED unless this is set (min 16 chars).
BAAL_ADMIN_TOKEN=

# Agent tuning
BAAL_MAX_SUBJECTS=50
BAAL_THRESHOLD=0.72
BAAL_PLAN_DEPTH=3
BAAL_MEMORY_HOURS=24

# Baseline governance
BAAL_MIN_BASELINE_SAMPLES=30

# Outcome attribution: % of eligible interventions replaced by silent
# observation to measure natural resolution. 0 disables. Never applies to
# intents requiring human notification.
BAAL_HOLDOUT_PCT=0

# Events older than this are dead-lettered instead of acted on (0 disables)
BAAL_EVENT_MAX_AGE_MS=60000

# Data lifecycle
BAAL_SIGNAL_RETENTION_DAYS=30

# Observability — binds localhost by default; set host explicitly for containers
BAAL_HEALTH_PORT=8787
BAAL_HEALTH_HOST=127.0.0.1

# Logging
NODE_ENV=development
LOG_FORMAT=pretty
LOG_LEVEL=INFO
